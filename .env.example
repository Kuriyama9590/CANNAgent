# CannAgent 环境变量模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 凭据只通过 apiKeyEnv 名称被 settings.yaml/profiles 引用，值不进任何仓库与 run 目录

# ── 模型端点（按启用的 provider 填写，三协议示例见 profiles/）──
# Anthropic Messages 协议（如 GLM/Anthropic 官方兼容端点）
ZAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# OpenAI Chat Completions 协议（DeepSeek 等）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# OpenAI Responses 协议（自建网关）
GATEWAY_API_KEY=
GATEWAY_BASE_URL=

# ── 昇腾服务器（迁移自 环境.txt 的敏感值放这里）──
CANN_SERVER_HOST=
CANN_SERVER_USER=
CANN_SERVER_PASSWORD=
